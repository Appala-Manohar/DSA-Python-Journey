class Solution(object):
    def removeDuplicates(self, nums):
        left=2
        if len(nums)<=2:
            return len(nums)
        for right in range(2,len(nums)):
            if nums[right]!=nums[left-2]:
                nums[left]=nums[right]
                left+=1
        return left
nums=[0,0,1,1,1,1,2,3,3]
sol=Solution()
k=sol.removeDuplicates(nums)
print(nums[:k])
