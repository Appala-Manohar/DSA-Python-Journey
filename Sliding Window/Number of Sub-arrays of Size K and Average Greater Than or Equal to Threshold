class Solution(object):
    def numOfSubarrays(self, arr, k, threshold):
        Csum=sum(arr[:k])
        count=0
        if Csum / k >= threshold:
            count += 1
        for i in range(k,len(arr)):
            Csum=Csum-arr[i-k]+arr[i]
            avg=Csum/k
            if avg>=threshold:
                count+=1
        return count
arr = [2,2,2,2,5,5,5,8]
k=3
threshold=4
sol=Solution()
ans=sol.numOfSubarrays(arr,k,threshold)
print(ans)
